{
  "name": "magic-portfolio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Minimal, bilingual (EN/FA) developer portfolio with blog, dashboard, and one-click Vercel deployment.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx --env-file=.env.local src/seed/seedData.ts",
    "seed:force": "FORCE_SEED=true tsx --env-file=.env.local src/seed/seedData.ts",
    "seed:list": "tsx --env-file=.env.local src/seed/seedData.ts --list-personas",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.84.2",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "^4.0.8",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.544.0",
    "mongoose": "^8.9.4",
    "next": "16.0.10",
    "next-auth": "^4.24.11",
    "next-intl": "4.6.0",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-date-object": "2.1.9",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.3",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^9.0.1",
    "react-multi-date-picker": "^4.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "25.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.10",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "shadcn": "^2.0.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
