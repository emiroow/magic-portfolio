# ------------------------------------------------------------------
# Magic Portfolio — environment template
# Copy to .env.local and fill in the values. Never commit .env.local.
# ------------------------------------------------------------------

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017/Magic"

# Canonical public URL of the site. Used for SEO, canonical/OG URLs and RSS.
# Development: http://localhost:3000 — Production: your real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth (required). Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Admin dashboard credentials — REQUIRED. There are no demo/fallback
# accounts: if these are missing, every sign-in attempt is refused.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="use-a-long-random-secret"

# Vercel Blob storage token — required for image uploads in production.
BLOB_READ_WRITE_TOKEN="change-me"

# Demo content (only read by `npm run seed`).
# SEED_PERSONA: frontend | backend | fullstack | designer  (override per run with --persona=<id>)
# SEED_IMAGES=false skips the placeholder image URLs so the site shows its own monograms
SEED_PERSONA="frontend"
SEED_IMAGES="true"

# Optional extras
# Site title/description are NOT configured here — they come from the profile
# document you edit in the dashboard (Name | Job Title | Portfolio).
NEXT_PUBLIC_TWITTER_HANDLE="@username"
NEXT_PUBLIC_GA_ID="change-me"

# ------------------------------------------------------------------
# Buy me a coffee / financial support — ALL OPTIONAL
# ------------------------------------------------------------------
# Support options that hand off to a platform, a prepared payment link, a card
# number or a crypto address need nothing here: edit them in the dashboard under
# "Buy me a coffee". Only the `gateway` mode — a checkout the site starts itself —
# reads credentials from the environment. A gateway with no keys is simply never
# offered, and an option pointing at one reports the reason at checkout.
#
# Amounts are converted from the option's currency: toman -> rial (x10) for the
# Iranian rails, whole units -> cents for the international ones.

# ZarinPal v4 (Iranian). Sandbox merchant: https://sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="true"
# ZARINPAL_API_BASE="https://api.zarinpal.com"
# ZARINPAL_PAY_BASE="https://www.zarinpal.com/pg/StartPay"

# IDPay REST (Iranian). Token and reseller id come from the IDPay panel.
IDPAY_API_TOKEN="change-me"
IDPAY_RESELLER_ID="change-me"
# IDPAY_API_BASE="https://idpay.ir"

# Stripe Checkout (international). Secret key starts with sk_test / sk_live.
# Only usd and eur can be charged through it.
# STRIPE_SECRET_KEY="sk_test_change-me"
# STRIPE_API_BASE="https://api.stripe.com"

# PayPal Orders v2 (international). usd and eur only.
# PAYPAL_CLIENT_ID="change-me"
# PAYPAL_SECRET="change-me"
# PAYPAL_ENV="sandbox"   # or "live"
# PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# Gateway callbacks need the public origin, so NEXT_PUBLIC_SITE_URL must be set
# to a reachable URL before any `gateway` option is published.
