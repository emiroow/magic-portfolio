# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Keep the upload folders themselves, ignore uploaded content
public/avatar/*
!public/avatar/.gitkeep
public/projects/*
!public/projects/.gitkeep
public/products/*
!public/products/.gitkeep
public/experience/*
!public/experience/.gitkeep
public/education/*
!public/education/.gitkeep
public/blog/*
!public/blog/.gitkeep

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.env
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
